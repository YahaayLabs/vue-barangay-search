{
  "name": "vue-barangay-search",
  "version": "0.2.0",
  "description": "Vue 3 autocomplete for Philippine barangays — powered by the GIS.ph API",
  "type": "module",
  "license": "MIT",
  "author": "Yahaay Labs <gerald@yahaay.com>",
  "homepage": "https://gis.ph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YahaayLabs/vue-barangay-search.git"
  },
  "bugs": {
    "url": "https://github.com/YahaayLabs/vue-barangay-search/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "barangay",
    "philippines",
    "autocomplete",
    "address",
    "lgu",
    "psgc",
    "gis",
    "gis.ph",
    "typescript",
    "component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/vue-barangay-search.umd.cjs",
  "module": "./dist/vue-barangay-search.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/vue-barangay-search.js",
      "require": "./dist/vue-barangay-search.umd.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dist/style.css": "./dist/vue-barangay-search.css",
    "./dist/vue-barangay-search.css": "./dist/vue-barangay-search.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@vueuse/core": "^12.5.0",
    "gis.ph-sdk": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}
